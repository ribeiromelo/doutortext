{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "lib": [
      "ESNext"
    ],
    "types": [
      "vite/client",
      "@cloudflare/workers-types"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx"
  },
  "exclude": [
    "node_modules",
    "dist"
  ],
  "include": [
    "src/index.tsx",
    "src/routes/**/*.ts",
    "src/lib/**/*.ts",
    "src/templates/**/*.ts",
    "vite*.ts"
  ]
}
