{
  "name": "webapp",
  "type": "module",
  "scripts": {
    "dev": "npm run build && npm run preview",
    "build": "vite build",
    "preview": "wrangler pages dev dist --local --ip 127.0.0.1 --port 3000",
    "deploy": "npm run build && wrangler pages deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:migrate:local": "wrangler d1 migrations apply doutortext-production --local",
    "db:seed": "wrangler d1 execute webapp-production --local --file=./seed.sql",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate:local",
    "assets": "node scripts/assets.mjs && vite build --config vite.editor.config.ts && vite build --config vite.dashboard.config.ts && tailwindcss -i src/styles.css -o public/static/utilities.css --minify",
    "prebuild": "npm run assets",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.browser.json",
    "test:dashboard": "node tests/dashboard.integration.mjs"
  },
  "dependencies": {
    "@tiptap/core": "^3.34.0",
    "@tiptap/extension-highlight": "^3.34.0",
    "@tiptap/extension-image": "^3.34.0",
    "@tiptap/extension-subscript": "^3.34.0",
    "@tiptap/extension-superscript": "^3.34.0",
    "@tiptap/extension-table": "^3.34.0",
    "@tiptap/extension-text-align": "^3.34.0",
    "@tiptap/extension-text-style": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "dompurify": "^3.4.18",
    "hono": "^4.13.19"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@hono/vite-build": "^1.11.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "wrangler": "^4.165.0"
  }
}
